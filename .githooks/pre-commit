#!/bin/bash
# Pre-commit hook — blocks commits containing hardcoded API keys or secrets.

RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Patterns for common secret formats
PATTERNS=(
  'sk-ant-api[0-9A-Za-z_-]{20,}'          # Anthropic
  'AKIA[0-9A-Z]{16}'                        # AWS Access Key ID
  'sk-[A-Za-z0-9]{48,}'                    # OpenAI
  'ghp_[A-Za-z0-9]{36,}'                   # GitHub Personal Access Token
  'gho_[A-Za-z0-9]{36,}'                   # GitHub OAuth Token
  'xox[baprs]-[0-9A-Za-z-]{10,}'           # Slack
  'AIza[0-9A-Za-z_-]{35,}'                 # Google API Key
  '-----BEGIN[[:space:]].*PRIVATE KEY-----' # Private keys (RSA, EC, etc.)
)

FOUND=0

while IFS= read -r FILE; do
  [ -z "$FILE" ] && continue

  CONTENT=$(git show ":$FILE" 2>/dev/null) || continue

  for PATTERN in "${PATTERNS[@]}"; do
    MATCHES=$(echo "$CONTENT" | grep -nE -- "$PATTERN")
    if [ -n "$MATCHES" ]; then
      if [ "$FOUND" -eq 0 ]; then
        echo ""
        echo -e "${RED}⛔  COMMIT BLOQUEADO — Posibles secretos detectados${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
      fi
      echo -e "  ${CYAN}📄 $FILE${NC}"
      while IFS= read -r LINE; do
        echo -e "     ${YELLOW}$LINE${NC}"
      done <<< "$MATCHES"
      echo ""
      FOUND=1
    fi
  done
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$FOUND" -eq 1 ]; then
  echo -e "  ${RED}Eliminá las credenciales antes de commitear.${NC}"
  echo -e "  Variables de entorno deben ir en ${YELLOW}.env.local${NC} (ya está en .gitignore)."
  echo -e "  Falso positivo: ${YELLOW}git commit --no-verify${NC}"
  echo ""
  exit 1
fi

exit 0
